package bg.tu_varna.sit.f24621744.task.ObjectInteract;

import bg.tu_varna.sit.f24621744.task.Command;
import bg.tu_varna.sit.f24621744.task.Session;
import bg.tu_varna.sit.f24621744.task.parser.JsonObject;
import bg.tu_varna.sit.f24621744.task.parser.JsonPrimitive;
import bg.tu_varna.sit.f24621744.task.parser.JsonToString;

public class Create implements Command {
    @Override
    public void execute(String arguments, Session session) {
        if (!session.isFileOpen()) {
            System.out.println("Error: Open a file first.");
            return;
        }

        String[] parts = arguments.split("\\s+", 2);
        if (parts.length < 2) {
            System.out.println("Usage: create <key> <value>");
            return;
        }

        String key = parts[0];
        String value = parts[1];

        JsonToString root = session.getRootNode();

        // if root == Json
        if (root instanceof JsonObject) {
            JsonObject obj = (JsonObject) root;
            obj.add(key, new JsonPrimitive(value));
            System.out.println("Property '" + key + "' added to memory.");
        } else {
            System.out.println("Error: Cannot add to an array or primitive.");
        }
    }

    @Override
    public String getDescription() {
        return "create <key> <value> - adds a new property to the JSON object";
    }
}