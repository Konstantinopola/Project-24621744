package bg.tu_varna.sit.f24621744.task;

import java.nio.file.Path;

public class Session {
    private Path currentFilePath;
    private String jsonInMemory;

    public boolean isFileOpen() {
        return currentFilePath != null;
    }

    public Path getCurrentFilePath() {
        return currentFilePath;
    }

    public void openFile(Path path, String content) {
        this.currentFilePath = path;
        this.jsonInMemory = content;
    }

    public void closeFile() {
        this.currentFilePath = null;
        this.jsonInMemory = null;
    }

    public String getJsonInMemory() {
        return jsonInMemory;
    }

    public void setJsonInMemory(String jsonInMemory) {
        this.jsonInMemory = jsonInMemory;
    }
}
